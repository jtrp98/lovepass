# ============================================================
# LOVE PASS Backend — env (.NET อ่านไฟล์นี้ตอน startup)
# คัดลอกเป็น backend/.env แล้วเติมค่าเอง: cp .env.example .env
# ชื่อตัวแปรตรงกับ configuration path (ใช้ __ แทน : เหมือน env var ปกติ)
# ============================================================

ASPNETCORE_ENVIRONMENT=Development

# --- PostgreSQL (ต้องตรงกับ root .env ของ docker-compose) ---
ConnectionStrings__DefaultConnection=Host=localhost;Port=5433;Database=lovepass;Username=postgres;Password=changeme

# --- JWT (SigningKey ต้องเป็น random string ยาว 64+ ตัวอักษร) ---
Jwt__Issuer=lovepass-api
Jwt__Audience=lovepass-web
Jwt__SigningKey=CHANGE_ME_random_string_at_least_64_characters_long_xxxxxxxxxxxxxxxx
Jwt__AccessTokenTtlMinutes=15
Jwt__RefreshTokenTtlDays=30

# --- CORS / App (origin ของ frontend) ---
Cors__AllowedOrigins=http://localhost:3000
App__FrontendUrl=http://localhost:3000

# --- Email: Resend หรือ Gmail (ใช้ scripts/setup-gmail.mjs เชื่อมบัญชี Gmail) ---
Email__Provider=Resend

# --- Gmail API (ไม่ต้องมีโดเมน; setup script จะเติมค่าหลังอนุญาต Google) ---
Gmail__SenderEmail=
Gmail__ClientId=
Gmail__ClientSecret=
Gmail__RefreshToken=

# --- Resend (เมื่อเลือก Resend และไม่ใส่ key จะข้ามการส่งและ log แทน) ---
Resend__ApiKey=
Resend__FromEmail=LOVE PASS <onboarding@resend.dev>

# --- Seed (สร้างตอนรันครั้งแรกเมื่อ DB ว่าง) ---
Seed__AdminEmail=admin@lovepass.local
Seed__AdminPassword=Admin@12345
Seed__DemoTemplates=true

# --- Google Sign-In (เว้นว่าง = ปิดใช้งาน) ---
# สร้างได้ที่ Google Cloud Console → APIs & Services → Credentials → OAuth client ID
# ต้องใช้ Client ID เดียวกันกับ NEXT_PUBLIC_GOOGLE_CLIENT_ID ของ frontend
Authentication__Google__ClientId=
